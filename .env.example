DOMAIN=touji.example.com
APP_ORIGIN=https://touji.example.com
ACCOUNT_ORIGIN=https://orbitshz.com
IDENTITY_PROVIDER=session
# Only with IDENTITY_PROVIDER=orbit: the same value the reverse proxy sends as
# X-Orbit-Proxy-Secret (at least 32 characters). See docs/deployment/aws.md.
ORBIT_PROXY_SECRET=

POSTGRES_DB=touji
POSTGRES_USER=touji
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://touji:replace-with-a-long-random-password@db:5432/touji
SESSION_SECRET=replace-with-at-least-32-random-characters
